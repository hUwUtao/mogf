    def Scope "_materials"
    {
        def Material "USD_PreviewSurface_Scalars_001" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </root/_materials/USD_PreviewSurface_Scalars_001/Principled_BSDF.outputs:surface>
